rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipantByResource() {
      return isSignedIn() && request.auth.uid in resource.data.participants;
    }

    // ── Users ────────────────────────────────────────────────────
    // Anyone signed in can read any user profile (needed for search, profiles)
    // Only the owner can write their own profile
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false; // no account deletion via client
    }

    // ── Follows ──────────────────────────────────────────────────
    // Anyone signed in can read follows (needed to build feeds)
    // Only the follower can create/delete their own follow doc
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.followerId;
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.followerId;
      allow update: if false;
    }

    // ── Posts ────────────────────────────────────────────────────
    // Anyone signed in can read posts
    // Only the author can create / update / delete their post
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.authorId;
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.authorId;
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.authorId;
    }

    // ── Likes ────────────────────────────────────────────────────
    // Like doc ID is "{userId}_{postId}"
    // Only the liking user can create/delete their own like
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ── Comments ─────────────────────────────────────────────────
    // Anyone signed in can read comments
    // Author can create and delete their own comments
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.authorId;
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.authorId;
      allow update: if false; // no editing comments
    }

    // ── Notifications ────────────────────────────────────────────
    // Only the recipient can read their notifications
    // Any signed-in user can create notifications (to notify others)
    // Only the recipient can update (mark as read) or delete
    match /notifications/{notifId} {
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
    }

    // ── Conversations ─────────────────────────────────────────────
    // Only participants can read or write a conversation.
    // Uses resource.data (not get()) so list queries work correctly.
    match /conversations/{convId} {
      allow read: if isParticipantByResource();
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isParticipantByResource();
      allow delete: if false;
    }

    // ── Messages ──────────────────────────────────────────────────
    // Only participants of the parent conversation can read/write messages.
    // get() is acceptable here since it's a cross-collection lookup (not circular).
    match /messages/{messageId} {
      allow read: if isSignedIn()
                  && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.senderId
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
      allow update: if false;
      allow delete: if false;
    }

  }
}
